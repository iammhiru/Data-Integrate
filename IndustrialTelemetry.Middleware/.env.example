# IndustrialTelemetry.Middleware — cấu hình
# Copy file này thành .env rồi chỉnh giá trị cho môi trường chạy thật.

# ─── OPC UA (Kepware) ───────────────────────────────────────────────────────
OPC_SERVER_URL=opc.tcp://localhost:49320
OPC_SUB_PUBLISHING_INTERVAL_MS=100
OPC_SESSION_TIMEOUT_MS=600000

# ─── Metadata ───────────────────────────────────────────────────────────────
# Đường dẫn tương đối được tính từ thư mục IndustrialTelemetry.Middleware/
TAG_FOLDER=metadata/TAG_FOLDER
EQUIPMENT_MAP_FILE=metadata/equipment_map.json
CATALOG_FILE=metadata/catalog.json
REQUIRE_TAG_CODE=true

# ─── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=industrial.telemetry
KAFKA_ACKS=all
KAFKA_RETRIES=10
KAFKA_MAX_IN_FLIGHT=1
KAFKA_LINGER_MS=50
KAFKA_BATCH_SIZE=65536
KAFKA_BUFFER_MEMORY=33554432
KAFKA_COMPRESSION_TYPE=gzip
KAFKA_SEND_TIMEOUT_SEC=30
KAFKA_FLUSH_TIMEOUT_SEC=10

# ─── Data contract ──────────────────────────────────────────────────────────
SCHEMA_VERSION=1.0
EVENT_TYPE=machine.telemetry
SOURCE_SYSTEM=kepware

# ─── Queue & dedup ──────────────────────────────────────────────────────────
VALUE_QUEUE_MAXSIZE=200000
VALUE_QUEUE_WARN_THRESHOLD=50000
VALUE_QUEUE_GET_TIMEOUT_SEC=1
NODE_CACHE_MAX=50000
# false = change-detection (chỉ phát khi giá trị đổi) — baseline của design doc
USE_TIMESTAMP_IN_RECONNECT_DEDUP=false

# ─── Connection health ──────────────────────────────────────────────────────
INACTIVITY_TIMEOUT_S=600
TRANSPORT_ERROR_THRESHOLD=3
STABLE_QUIET_SECONDS=10
STABLE_MIN_SUBSCRIBE_RATIO=0.90

# ─── Periodic refresh (giữ dữ liệu "sống") ────────────────────────────────
# Middleware chỉ phát message khi giá trị THAY ĐỔI (change-detection dedup).
# Tag tĩnh (máy dừng, counter đứng yên) sẽ không có datachange → eventTime của
# bản ghi cũ dần "hết hạn" → dashboard hiển thị NO_DATA dù kết nối vẫn tốt.
# Cơ chế này đọc lại giá trị hiện tại theo chu kỳ (mô phỏng polling của một
# OPC UA client thông thường). Đặt 0 để tắt hoàn toàn.
REFRESH_INTERVAL_S=20.0
# Số tag đọc lại trong MỘT lượt refresh (chia để không tắc cổng chặn STABLE).
REFRESH_BATCH_SIZE=40

# ─── Baseline replay ────────────────────────────────────────────────────────
# true → ở lần khởi động ĐẦU TIÊN, middleware phát luôn giá trị hiện tại của
# mọi tag lên Kafka (bỏ qua cơ chế chặn "baseline replay"). Nhờ vậy dashboard
# hiển thị trạng thái hiện tại của toàn bộ máy ngay khi bật.
# Cờ này CHỈ áp dụng cho chu kỳ khởi động đầu tiên — sau reconnect, cơ chế
# chặn baseline replay vẫn hoạt động bình thường.
PUBLISH_INITIAL_SNAPSHOT=false

# ─── Simulation mode (giả lập — KHÔNG cần Kepware) ──────────────────────────
# Bật lên true → middleware KHÔNG kết nối Kepware, tự sinh dữ liệu cho toàn bộ
# tag trong TAG_FOLDER rồi gửi vào Kafka đúng data contract đã chốt.
# Dùng cho máy của đồng đội không cài được Kepware.
SIMULATION_MODE=false
# Nhịp quét simulator (ms) — nhịp kiểm tra tag nào đã đến hạn phát.
SIMULATION_TICK_MS=200
# Hệ số tốc độ mô phỏng: 1.0 = thời gian thực, 10.0 = nhanh gấp 10.
SIMULATION_SPEED_FACTOR=1.0
# Scan Rate mặc định (ms) cho tag không khai báo trong CSV.
SIMULATION_DEFAULT_SCAN_MS=1000
# Seed cho RNG — cùng seed ⇒ cùng chuỗi dữ liệu (tiện cho test).
SIMULATION_SEED=20261111
# Tỷ lệ phát lỗi chất lượng giả lập (0 = luôn Good).
SIMULATION_QUALITY_FAULT_RATE=0.01
# Giá trị ghi trong source.system khi chạy chế độ giả lập.
SIMULATION_SOURCE_SYSTEM=simulator

# ─── Logging ────────────────────────────────────────────────────────────────
LOGS_DIR=logs
LOG_MAX_FILES=7
LOG_FILE_LEVEL=INFO
LOG_CONSOLE_LEVEL=INFO
OPCUA_LOG_LEVEL=WARNING

# ─── Stats ──────────────────────────────────────────────────────────────────
STATS_INTERVAL_SEC=60
