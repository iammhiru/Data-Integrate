# Copy thanh .env roi chinh sua:  cp .env.example .env
# ⚠ File .env bi git-ignore — KHONG commit (chua thong tin truy cap may server).

# ─── KAFKA (cluster that tren may server 192.168.179.176) ─────────────────────
# Kafka chay bang docker compose rieng tren may server
# (docker-compose.kafka-fixed.yml) — khong can bien nay o day, nhung giu lai
# de dung chung khi can.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BOOTSTRAP=192.168.179.176:29092
KAFKA_TOPIC=industrial.telemetry
STATE_TOPIC=machine-state

# ─── MINIO (Data Lake — may server 192.168.179.176) ──────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# Spark/duong dan S3 (dung khi chay spark tren may Windows)
MINIO_ENDPOINT=http://192.168.179.176:4434
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=smart-factory
# Endpoint ghi ra truc tiep tu may Windows (khong qua DNS trong docker)
MINIO_ENDPOINT_WIN=http://192.168.179.176:4434

MINIO_S3_PORT=4434
MINIO_CONSOLE_PORT=4435
MINIO_IMAGE=alpine/minio:RELEASE.2025-10-15T17-29-55Z


# ─── POSTGRESQL (may server 192.168.179.176) ─────────────────────────────────
POSTGRES_DB=smart_factory
POSTGRES_USER=sf_user
POSTGRES_PASSWORD=sf_password
POSTGRES_JDBC_URL=jdbc:postgresql://192.168.179.176:5432/smart_factory
# master-api dung bien nay de doc master data
MASTER_DB_URL=postgres://sf_user:sf_password@192.168.179.176:5432/smart_factory

# ─── Spark worker ────────────────────────────────────────────────────────────
SPARK_WORKER_CORES=6
SPARK_WORKER_MEMORY=3g

# ─── Spark chạy trên SERVER 192.168.179.176 (docker-compose.spark-server.yml) ─
# Port đã kiểm tra trống trên server: 4040 (raw-ingest), 4041 (machine-state),
# 4042 (batch-kpi). KHÔNG dùng 8080/8081 (đã có dịch vụ khác).
# raw-ingest chỉ đọc topic từ `earliest` khi chưa có checkpoint; Kafka có
# ~2.5 triệu message nên lần catch-up đầu mất ~13 phút. Đổi sang `latest`
# nếu chỉ cần dữ liệu mới.
RAW_INGEST_OFFSETS=earliest
BATCH_INTERVAL_SEC=300
DAILY_AT=00:30
PLANT_TZ=Asia/Ho_Chi_Minh

# ─── Dashboard (host loopback) ───────────────────────────────────────────────
DASHBOARD_PORT=5080
