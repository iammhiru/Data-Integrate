# Copy thanh .env roi chinh sua:  cp .env.example .env

# Kafka (KRaft) - cluster id 22 ky tu base64, tao moi bang:
#   docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BOOTSTRAP=kafka:9092

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=smart-factory

# PostgreSQL
POSTGRES_DB=smart_factory
POSTGRES_USER=sf_user
POSTGRES_PASSWORD=sf_password
POSTGRES_JDBC_URL=jdbc:postgresql://postgres:5432/smart_factory

# Spark worker
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
